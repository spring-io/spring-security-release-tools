name: Release Announcements - Publish

on:
  workflow_dispatch:
    inputs:
      version:
        description: The version to publish
        required: true

permissions:
  actions: write
  contents: read
  issues: write

jobs:
<<#workflow.generator.workflows.release-tools.deploy-schema>>
  setup:
    name: Compute Inputs
    runs-on: ubuntu-latest
    outputs:
      release-channel: ${{ steps.environment.outputs.release-channel }}
    steps:
      - uses: actions/checkout
      - id: environment
        name: Compute Build Environment
        uses: spring-io/spring-security-actions/compute-build-environment
  deploy-schema:
    name: Deploy Schema
    needs: setup
    if: needs.setup.outputs.release-channel == 'oss'
    uses: spring-io/spring-security-release-tools/.github/workflows/ci-deploy-schema.yml
    with:
      java-version: '<< workflow.generator.project.java.versions.primary >>'
      runner: ${{ vars.UBUNTU_RUNS_ON }}
    secrets:
      docs-ssh-key: ${{ secrets.DOCS_SSH_KEY }}
      docs-username: ${{ secrets.DOCS_USERNAME }}
      docs-host: ${{ secrets.DOCS_HOST }}
<</workflow.generator.workflows.release-tools.deploy-schema>>
  publish-release-announcements:
    name: Publish Release Announcements
<<#workflow.generator.workflows.release-tools.deploy-schema>>
    needs: [ deploy-schema ]
    if: ${{ !failure() && !cancelled() }}
<</workflow.generator.workflows.release-tools.deploy-schema>>
    uses: spring-io/spring-security-release-tools/.github/workflows/release-announcements-publish.yml
    with:
      version: ${{ inputs.version }}
    secrets: inherit
